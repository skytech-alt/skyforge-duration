функция разобрать_время(текст) {
    пусть сумма = 0
    пусть число = ""
    пусть ед = ""
    для с в строка_символы(текст) {
        если цифра(с) { число = число + с }
        иначе если с != " " { ед = ед + с }
    }
    если ед == "h" { вернуть число(число) * 3600 }
    вернуть число(число) * 60
}