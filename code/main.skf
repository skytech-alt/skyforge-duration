// skyforge-duration

// ---------- ВРЕМЯ ----------

функция вычислить_время(число_стр, ед) {
    пусть ч = число(число_стр)
    пусть е = нижний_регистр(ед)
    
    если е == "s" или е == "sec" или е == "с" {
        вернуть ч
    }
    если е == "m" или е == "min" или е == "м" {
        вернуть ч * 60
    }
    если е == "h" или е == "hr" или е == "ч" {
        вернуть ч * 3600
    }
    если е == "d" или е == "day" или е == "д" {
        вернуть ч * 86400
    }
    вернуть 0
}

функция разобрать_время(текст) {
    пусть сумма = 0
    пусть текущее_число = ""
    пусть текущая_единица = ""
    
    для с в строка_символы(текст) {
        если цифра(с) или с == "." {
            если текущая_единица != "" {
                сумма = сумма + вычислить_время(текущее_число, текущая_единица)
                текущее_число = ""
                текущая_единица = ""
            }
            текущее_число = текущее_число + с
        } иначе если с != " " {
            текущая_единица = текущая_единица + с
        }
    }
    
    если текущее_число != "" и текущая_единица != "" {
        сумма = сумма + вычислить_время(текущее_число, текущая_единица)
    }
    
    вернуть сумма
}

функция формат_время(секунды) {
    если секунды == 0 {
        вернуть "0s"
    }
    
    пусть остаток = секунды
    пусть рез = ""
    
    пусть д = пол(остаток / 86400)
    если д > 0 {
        рез = рез + строка(д) + "d "
        остаток = остаток - д * 86400
    }
    
    пусть ч = пол(остаток / 3600)
    если ч > 0 {
        рез = рез + строка(ч) + "h "
        остаток = остаток - ч * 3600
    }
    
    пусть м = пол(остаток / 60)
    если м > 0 {
        рез = рез + строка(м) + "m "
        остаток = остаток - м * 60
    }
    
    если остаток > 0 или рез == "" {
        рез = рез + строка(остаток) + "s"
    }
    
    вернуть обрезать(рез)
}

// ---------- РАЗМЕРЫ ----------

функция вычислить_размер(число_стр, ед) {
    пусть ч = число(число_стр)
    пусть е = нижний_регистр(ед)
    
    если е == "kb" или е == "k" {
        вернуть ч * 1024
    }
    если е == "mb" или е == "m" {
        вернуть ч * 1048576
    }
    если е == "gb" или е == "g" {
        вернуть ч * 1073741824
    }
    если е == "tb" или е == "t" {
        вернуть ч * 1099511627776
    }
    вернуть ч
}

функция разобрать_размер(текст) {
    пусть текущее_число = ""
    пусть текущая_единица = ""
    
    для с в строка_символы(текст) {
        если цифра(с) или с == "." {
            если текущая_единица != "" {
                вернуть вычислить_размер(текущее_число, текущая_единица)
            }
            текущее_число = текущее_число + с
        } иначе если с != " " {
            текущая_единица = текущая_единица + с
        }
    }
    
    если текущее_число != "" {
        вернуть вычислить_размер(текущее_число, текущая_единица)
    }
    
    вернуть 0
}
